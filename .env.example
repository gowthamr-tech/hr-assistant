# Paths: defaults point at ./data (mounted at /app/data inside the container).
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date for all date rules (YYYY-MM-DD). Leave empty to use the system date.
APP_TODAY=

# LLM provider: anthropic (default, tested path), openai or gemini.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional overrides
# LLM_MODEL=claude-opus-5-5          # openai default: gpt-4.1-mini, gemini default: gemini-3-flash-preview
# LLM_ROUTER_MODEL=                  # model for the interpreter call; defaults to LLM_MODEL
# ANTHROPIC_EFFORT=low
# ANTHROPIC_REFUSAL_FALLBACK=true
# LLM_TIMEOUT_S=20
# LLM_MAX_RETRIES=1
# REQUEST_DEADLINE_S=27
# EMBEDDINGS_ENABLED=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# LOG_LEVEL=INFO
# LOG_FILE=
# LOG_FORMAT=auto                # auto | pretty | json (auto = pretty in a terminal, json in Docker)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash
# Vertex AI instead of AI Studio:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=           # set to use gcloud login credentials (no key); omit to use GOOGLE_API_KEY (express mode)
# GOOGLE_CLOUD_LOCATION=global
# Local open-source models through Ollama (e.g. LLM_PROVIDER=ollama LLM_MODEL=mistral:7b):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------- production
# development (default) or production. production refuses unsafe settings at start-up:
# AUTH_MODE=header, a missing LLM key, APP_TODAY, CORS_ALLOW_ORIGINS=*. It also turns the UI off
# and adds HSTS. See docs/DEPLOYMENT.md.
APP_ENV=development

# How callers prove who they are: header (dev only) | gateway | jwt
AUTH_MODE=header
# gateway: your authenticating proxy sets X-Employee-Id and sends X-Gateway-Token with this value (>= 32 chars)
# AUTH_GATEWAY_TOKEN=
# jwt: Authorization: Bearer <token>. HS256 needs a secret (>= 32 chars); RS256/ES256 need a PEM public key
# AUTH_JWT_ALGORITHMS=HS256
# AUTH_JWT_SECRET=
# AUTH_JWT_PUBLIC_KEY=            # PEM; "\n" sequences are turned into newlines
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
# AUTH_JWT_EMPLOYEE_CLAIM=sub

# RATE_LIMIT_PER_MINUTE=30        # per employee, per replica; 0 disables
# CORS_ALLOW_ORIGINS=             # comma-separated origins for a browser front end; empty = no CORS
# UI_ENABLED=                     # test page at /; default on in development, off in production
# METRICS_ENABLED=true            # Prometheus /metrics; keep it off the public ingress
# RETENTION_DAYS=90               # delete chat history older than this; 0 keeps it forever
# PENDING_TTL_MINUTES=30          # an unconfirmed leave proposal expires after this
